# Plantilla de variables para despliegue local (ver .docs/06_DESPLIEGUE_LOCAL.md)
# Copiar a `.env` (ignorado por git) y completar con credenciales reales.

# --- Base de datos (SQL Server, solo lectura sobre storage/dma/dwh) ---
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=storage;encrypt=true;trustServerCertificate=true
DB_USER=usuario_lectura
DB_PASSWORD=changeit

# --- SMTP (local: Mailpit del docker-compose; prod: relay corporativo) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# --- Perfil y rutas ---
SPRING_PROFILES_ACTIVE=dev
TMP_REPORTES=/tmp/reportes

# --- Remitente / destinatarios (en perfil dev todos van a dev@localhost) ---
MAIL_FROM=reportes@confianza.pe
MAIL_SOPORTE=soporte-ti@confianza.pe
MAIL_VALIDACIONES=mis-datos@confianza.pe
MAIL_RIESGOS=riesgos@confianza.pe
MAIL_CANALES=canales@confianza.pe
MAIL_TESORERIA=tesoreria@confianza.pe
MAIL_FINANZAS=finanzas@confianza.pe
MAIL_COMERCIAL=comercial@confianza.pe
MAIL_SEGUROS=seguros@confianza.pe
MAIL_PASIVOS=pasivos@confianza.pe
