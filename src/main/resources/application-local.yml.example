# Plantilla del perfil "local" — copiar a application-local.yml (ese archivo
# SÍ está en .gitignore, este .example NO: es seguro de versionar porque no
# lleva secretos reales).
#
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
#   # editar application-local.yml con tus credenciales reales
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev,local
#
# Ver .docs/06_DESPLIEGUE_LOCAL.md §2.6 para el detalle de cada campo.

db:
  server: SERVIDOR-BD          # igual que en la ventana "Connect to Server" de SSMS
  database: storage
  domain: DOMINIO              # borrar esta línea (o dejar vacío) para SQL Server Authentication
  username: usuario            # SIN el prefijo DOMINIO\
  password: mi_password
  # instance: SQLEXPRESS       # solo si la instancia tiene nombre (SERVIDOR\SQLEXPRESS)
  # port: 1433

spring:
  mail:
    username: mi.usuario@confianza.pe
    password: abcdefghijklmnop   # contraseña de aplicación de Google, 16 caracteres JUNTOS

reportes:
  correo-remitente: mi.usuario@confianza.pe
  correo-soporte: mi.usuario@confianza.pe
  firma-nombre: Nombre Apellido
  firma-cargo: Cargo
  # firma-direccion y firma-web ya traen el default corporativo (application.yml);
  # el logo también (classpath:static/logo-confianza.png). Para usar otra imagen:
  # firma-logo-path: file:C:/ruta/a/otro-logo.png
  # google-chat-webhook-url: https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=...
